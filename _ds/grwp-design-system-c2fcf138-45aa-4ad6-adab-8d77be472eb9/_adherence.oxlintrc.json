        "selector": "JSXOpeningElement[name.name='VoteCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<VoteCard> tone must be one of 'light' | 'dark'."
      }
