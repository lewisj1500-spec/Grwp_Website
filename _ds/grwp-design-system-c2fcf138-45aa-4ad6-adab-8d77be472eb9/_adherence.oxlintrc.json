      {
        "selector": "JSXOpeningElement[name.name='SegmentedTabs'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SegmentedTabs> tone must be one of 'light' | 'dark'."
